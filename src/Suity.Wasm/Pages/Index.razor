@page "/"

<h1>Suity.Wasm</h1>
<p>A C# WebAssembly demo running in the browser.</p>

<div class="info-card">
    <h2>Project Info</h2>
    <p>This is a Blazor WebAssembly application built with .NET 10.</p>
    <ul>
        <li>Runs entirely in the browser</li>
        <li>No server-side processing required</li>
        <li>C# code compiled to WebAssembly</li>
        <li>Full .NET runtime in the browser</li>
    </ul>
</div>

<div class="info-card">
    <h2>Counter Demo</h2>
    <p>Click the buttons to test C# interop in the browser.</p>
    <div class="counter-section">
        <button @onclick="Decrement">-</button>
        <div class="counter-value">@count</div>
        <button @onclick="Increment">+</button>
    </div>
</div>

<div class="info-card">
    <h2>Calculator (Pure C#)</h2>
    <p>Uses <code>Calculator.cs</code> - a pure C# class.</p>
    <div style="margin-top: 1rem;">
        <input @bind="numA" type="number" style="width:80px; padding:0.3rem;" />
        <select @bind="op" style="padding:0.3rem;">
            <option value="+">+</option>
            <option value="-">-</option>
            <option value="*">*</option>
            <option value="/">/</option>
        </select>
        <input @bind="numB" type="number" style="width:80px; padding:0.3rem;" />
        <button @onclick="Calculate" style="margin-left:0.5rem;">=</button>
        <span class="counter-value" style="margin-left:1rem;">@calcResult</span>
    </div>
</div>

<div class="info-card">
    <h2>Fibonacci (Pure C#)</h2>
    <p>Uses <code>FibonacciGenerator.cs</code> - a pure C# class.</p>
    <div style="margin-top: 1rem;">
        <label>Count: </label>
        <input @bind="fibCount" type="number" min="1" max="50" style="width:60px; padding:0.3rem;" />
        <button @onclick="GenerateFib" style="margin-left:0.5rem;">Generate</button>
    </div>
    <p style="margin-top:1rem; font-family:monospace; color:#00d4ff; word-break:break-all;">
        @fibSequence
    </p>
</div>

@code {
    private int count = 0;
    private double numA = 0;
    private double numB = 0;
    private string op = "+";
    private string calcResult = "0";
    private int fibCount = 10;
    private string fibSequence = "";
    private readonly FibonacciGenerator fibGen = new();

    private void Increment() => count++;
    private void Decrement() => count--;

    private void Calculate()
    {
        try
        {
            double result = op switch
            {
                "+" => Calculator.Add(numA, numB),
                "-" => Calculator.Subtract(numA, numB),
                "*" => Calculator.Multiply(numA, numB),
                "/" => Calculator.Divide(numA, numB),
                _ => 0
            };
            calcResult = Calculator.FormatResult(result);
        }
        catch (Exception ex)
        {
            calcResult = ex.Message;
        }
    }

    private void GenerateFib()
    {
        fibGen.Generate(fibCount);
        fibSequence = fibGen.GetSequenceString();
    }
}
